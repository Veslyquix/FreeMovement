// Test chapter: the prologue on Ephraim's Ch14 castle map (29x31), with its doors, chests and shop
#include EAstdlib.event
EventPointerTable(7,MyPrologue)

// the prologue's map, tiles, palette etc. become Ch14's (LOMA would make it count as a skirmish)
PUSH
ORG $8B0890+4
BYTE $79 $00 $7A $7B $7C $7D $00 $7E
POP

#define PX 13
#define PY 29

ALIGN 32
MyPrologue:
POIN TurnBasedEvents
POIN CharacterBasedEvents
POIN $9EA91C // Ch14's doors, chests and secret shop
POIN MiscBasedEvents
POIN Dunno Dunno Dunno
POIN Tutorial
POIN TrapData TrapData
POIN PlayerUnits EnemyUnits
POIN $0 $0 $0 $0 $0 $0
POIN BeginningScene EndingScene

ALIGN 32
PlayerUnits:
UNIT Eirika EirikaLord Eirika Level(1,Ally,False) [PX,PY] 0x0 0x0 0x0 0x1 [Rapier,Vulnerary] NoAI
UNIT 0x2 General Eirika Level(1,Ally,False) [PX+1,PY] 0x0 0x0 0x0 0x1 [SilverLance,SteelSword] NoAI
UNIT Franz Cavalier Eirika Level(1,Ally,False) [PX+2,PY] 0x0 0x0 0x0 0x1 [IronSword] NoAI
UNIT Gilliam Knight Eirika Level(1,Ally,False) [PX,PY+1] 0x0 0x0 0x0 0x1 [IronLance] NoAI
UNIT Vanessa PegasusKnight Eirika Level(1,Ally,False) [PX+1,PY+1] 0x0 0x0 0x0 0x1 [IronLance] NoAI
UNIT 0x2E 0x34 Eirika Level(1,Ally,False) [PX+2,PY+1] 0x0 0x0 0x0 0x1 [IronSword] NoAI
UNIT

ALIGN 32
EnemyUnits:
UNIT 0x68 0x3F 0x0 0x24 [26,19] 0b 0x0 0x1 0x8B3BFC [0x1F,0x0,0x0,0x0] [0x6,0x3,0x0,0x0]
UNIT 0x82 0x3F 0x0 0xC [27,19] 0b 0x0 0x1 0x8B3C04 [0x1F,0x0,0x0,0x0] [0x0,0xA,0x0,0x0]
UNIT

ALIGN 32
TurnBasedEvents:
END_MAIN

ALIGN 32 //For some reason, CharacterBasedEvents have to be 32-Aligned
CharacterBasedEvents:
CharacterEventBothWays(0x5,TalkEv,Eirika,0x2)
END_MAIN

ALIGN 32
Dunno:
WORD $00
END_MAIN

ALIGN 32
Tutorial:
WORD $00
END_MAIN

ALIGN 32
TrapData:
ENDTRAP

ALIGN 32
BeginningScene:
LOAD1 1 PlayerUnits
ENUN
LOAD1 1 EnemyUnits
ENUN

EnableFreeMovement
AddTrap(0x6,PX-2,PY) // dragon vein, press A on it
AddTrap(0xE,PX+4,PY) // hurts when stepped on

ENDA

ALIGN 32
EndingScene:
MNC2 0x1
ENDA

ALIGN 32
TalkEv:
Text(0x969)
ENDA

ALIGN 32
MiscBasedEvents:
DefeatAll(EndingScene)
END_MAIN
